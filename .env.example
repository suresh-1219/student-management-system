# Copy this file to .env and fill in real values, then run:
#   docker compose up --build
#
# .env is in .gitignore - never commit your real one.

DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters

# Optional: creates an admin user on first startup if set.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
