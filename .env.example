# Copy this file to .env and fill in real values, then run:
#   docker compose up --build
#
# .env is in .gitignore - never commit your real one.

DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters

# Optional: creates an admin user on first startup if set.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: interactive API docs (Swagger UI). Defaults to true in Docker
# Compose; turn off for anything reachable from the internet.
SWAGGER_ENABLED=true

# Optional: browser origins allowed to call the API from another site
# (comma separated). Set to your real frontend URL when you have one.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: S3-compatible object storage for course syllabus files,
# backed by SeaweedFS (not MinIO - see docker-compose.yml). Defaults
# below match docker-compose.yml's own defaults, so this only needs
# changing for a non-default bucket name or real credentials.
S3_ACCESS_KEY=course-syllabi-app
S3_SECRET_KEY=change-me-course-syllabi-secret
S3_BUCKET=course-syllabi
